    out = m
    out = {**out, k: v}
    return out


def sum_keys(m: dict[str, int]) -> str:
    keys = ""
    for k in m:
        keys = keys + k
    return keys


def wrap(x: _T) -> _T | None:
    return _rt.some(x)


def nested(x: int | None) -> int | None | None:
    return wrap(x)


def depth(x: int | None | None) -> str:
    if x is None:
        return "none"
    elif x is not None and _rt.unwrap(x) is None:
        return "some(none)"
    else:
        n = _rt.unwrap(x)
        return f"some(some({n}))"


def get_or(xs: list[int], i: int, d: int) -> int:
    return _rt.unwrap_or(_rt.list_get(xs, i), d)


def at(xs: list[int], i: int) -> int:
    return _rt.index(xs, i)


def area(s: Shape) -> float:
    if isinstance(s, Shape.Dot):
        return 0.0
    elif isinstance(s, Shape.Circle):
        r = s._0
        return 3.0 * r * r
    else:
        w = s._0
        h = s._1
        return w * h


def classify(n: int, s: str, b: bool) -> str:
    if n == 0:
        a = "zero"
    elif n == 1:
        a = "one"
    else:
        a = "many"
    if s == "":
        c = "empty"
    else:
        other = s
        c = other
    if b:
        d = "yes"
    else:
        d = "no"
    return f"{a}/{c}/{d}"


def check(s: str) -> int:
    if len(s) == 0:
        raise _rt.Thrown(Failure.Empty())
    if not s.startswith("ok"):
        raise _rt.Thrown(Failure.Bad(s))
    return len(s)


def caught(s: str) -> str:
    try:
        n = check(s)
        return f"ok {n}"
    except _rt.Thrown as _t1:
        err = _t1.value
        if isinstance(err, Failure.Empty):
            return "empty"
        else:
            why = err._0
            return f"bad: {why}"


def thrown(s: str) -> int:
    return check(s)


def short(s: str) -> bool:
    return len(s) < 5


def validated(s: str) -> str:
    try:
        return _rt.validate(s, short, "short")
    except _rt.Thrown as _t1:
        err = _t1.value
        return err


def countdown(n: int) -> list[int]:
    out = []
    i = n
    while i > 0:
        out = [*out, i]
        i = i - 1
    return out


def early(xs: list[int]) -> int:
    for x in xs:
        if x < 0:
            return x
    return 0


def order(c: bool) -> str:
    _t1 = _rt.call_tool("log", "say", "a")
    if c:
        _t2 = _rt.call_tool("log", "say", "b")
    else:
        t = _rt.call_tool("log", "say", "c")
        _t2 = t
    a = join(_t1, _t2)
    _t3 = c
    if not _t3:
        _rt.call_tool("log", "say", "d")
        _t3 = True
    b = _t3
    return f"{a} {_rt.to_str(b)}"


def join(a: str, b: str) -> str:
    return a + b


def noop(x: int) -> None:
    if x > 0:
        return


def float_div(a: float, b: float) -> float:
    return _rt.fdiv(a, b)


_rt.record(Point, "Point", lambda: [
    ("x", "x", _rt.Int),
    ("from", "from_", _rt.Int),
])
_rt.record(Box, "Box", lambda: [
    ("item", "item", _rt.Param(0)),
])
_rt.enum(Shape, "Shape", lambda: [
    ("Dot", Shape.Dot, []),
    ("Circle", Shape.Circle, [_rt.Float]),
    ("Rect", Shape.Rect, [_rt.Float, _rt.Float]),
])
_rt.enum(Failure, "Failure", lambda: [
    ("Empty", Failure.Empty, []),
    ("Bad", Failure.Bad, [_rt.String]),
])

