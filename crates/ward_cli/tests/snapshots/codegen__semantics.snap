def shadowing() -> int:
    x = 1
    x_2 = 10
    y = x_2 + 1
    x_3 = x + y
    return x_3


def keywords(class_: int) -> int:
    lambda_ = class_ + 1
    p = Point(x=lambda_, from_=class_)
    return p.from_ + p.x


def bools(a: bool, b: bool) -> str:
    return f"{_rt.to_str(a)} {_rt.to_str(b)} {_rt.to_str(a == b)}"


def compare(a: int, b: int, c: bool) -> bool:
    return (a == b) == c


def moved(p: Point) -> Point:
    q = p
    q = _dc.replace(q, x=100)
    return q


def set_nested(boxes: list[Box[Point]], i: int, v: int) -> list[Box[Point]]:
    out = boxes
    out = _rt.list_set(out, i, _dc.replace(_rt.index(out, i), item=_dc.replace(_rt.index(out, i).item, x=v)))
    return out


