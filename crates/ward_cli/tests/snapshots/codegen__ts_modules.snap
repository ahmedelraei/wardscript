// Generated by `ward build --target typescript` from main.ward. Do not edit.
import * as _rt from "wardscript/rt";
import * as _shop_orders from "./shop/orders.ts";

export async function total(items: ReadonlyArray<_shop_orders.Item>): Promise<number> {
  return _rt.call("total", [["items", items]], async () => {
    let sum!: number;
    let item!: _shop_orders.Item;
    sum = 0;
    for (item of items) {
      sum = sum + await _shop_orders.price(item);
    }
    return sum;
  });
}

export async function restock(item: _shop_orders.Item): Promise<_shop_orders.Item> {
  return _rt.call("restock", [["item", item]], async () => {
    return ({ name: item.name, size: "Large", count: item.count + 1 } as _shop_orders.Item);
  });
}

=== shop/orders.ts ===
// Generated by `ward build --target typescript` from orders.ward. Do not edit.
import * as _rt from "wardscript/rt";

export interface Item {
  readonly name: string;
  readonly size: Size;
  readonly count: number;
}

export type Size = "Small" | "Large";

export const Item$ = _rt.record("Item", () => [["name", _rt.String], ["size", _rt.Adt(Size$)], ["count", _rt.Int]]);

export const Size$ = _rt.enum_("Size", () => [["Small", []], ["Large", []]]);

export async function price(item: Item): Promise<number> {
  return _rt.call("price", [["item", item]], async () => {
    let each!: number;
    if (item.size === "Small") {
      each = 2;
    } else {
      each = 5;
    }
    return each * item.count;
  });
}
