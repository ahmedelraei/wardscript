// Generated by `ward build --target typescript` from fallback.ward. Do not edit.
import * as _rt from "wardscript/rt";

async function summarize(text: string): Promise<string> {
  return _rt.call("summarize", [["text", text]], async () => {
    return (await _rt.ai("summarize", `Summarize in one line: ${text}`, _rt.String, { models: ["fast", "smart"], retries: 1, backoff: 0.0 })) as string;
  });
}

export async function digest(text: string): Promise<string> {
  return _rt.call("digest", [["text", text]], () => _rt.budget("digest", { calls: 3 }, async () => {
    return await summarize(text);
  }));
}
