# Generated by `ward build` from main.ward. Do not edit.
from __future__ import annotations

import shop.orders as _shop_orders
from wardscript import _rt

__all__ = [
    "total",
    "restock",
]


def total(items: list[_shop_orders.Item]) -> int:
    with _rt.call("total", [("items", items)]):
        sum = 0
        for item in items:
            sum = sum + _shop_orders.price(item)
        return sum


def restock(item: _shop_orders.Item) -> _shop_orders.Item:
    with _rt.call("restock", [("item", item)]):
        return _shop_orders.Item(name=item.name, size=_shop_orders.Size.Large, count=item.count + 1)

