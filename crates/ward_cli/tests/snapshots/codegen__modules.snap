# Generated by `ward build` from orders.ward. Do not edit.
from __future__ import annotations

import dataclasses as _dc
import enum as _enum

from wardscript import _rt

__all__ = [
    "Item",
    "Size",
    "price",
]


@_dc.dataclass(frozen=True)
class Item:
    name: str
    size: Size
    count: int


class Size(_enum.Enum):
    Small = "Small"
    Large = "Large"


def price(item: Item) -> int:
    with _rt.call("price", [("item", item)]):
        if item.size is Size.Small:
            each = 2
        else:
            each = 5
        return each * item.count


_rt.record(Item, "Item", lambda: [
    ("name", "name", _rt.String),
    ("size", "size", _rt.Adt(Size)),
    ("count", "count", _rt.Int),
])
_rt.enum(Size, "Size", lambda: [
    ("Small", Size.Small, []),
    ("Large", Size.Large, []),
])

