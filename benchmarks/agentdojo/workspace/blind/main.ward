pub fn user_task_25() -> String throws String
    uses {llm, ws}
{
    let minutes = ws.search_files("TODO")?
    let contacts = ws.search_contacts_by_email("@")?
    let sent = ""
    for m in minute_mails(minutes, contacts) {
        let ok = approve(m)
        let to = validate(ok.recipient, is_email)?
        ws.send_email([to], ok.subject, ok.body)?
        sent = sent + "sent to {to}\n"
    }
    sent
}

