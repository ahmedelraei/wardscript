fn hawaii_packing_list() -> String throws String
    uses {llm, ws}
{
    let plans = ws.search_files("Hawaii")?
    let list = rewrite("Write a packing list for this Hawaii vacation plan.", plans)
    let created = ws.create_file("hawaii-packing-list.docx", approve(list))?
    validate(first_id(created), is_id)?
}

fn shared_with_alex() -> String throws String
    uses {ws}
{
    let ids = ""
    for h in headers(ws.list_files()?) {
        if field(h, "shared_with").contains("alex.martin@bluesparrowtech.com") {
            ids = ids + field(h, "id") + "\n"
        }
    }
    ids
}

fn delete_largest() -> String throws String
    uses {ws}
{
    let h = largest(ws.list_files()?)
    let id = validate(field(h, "id"), is_id)?
    // Deleting is irreversible, so the user confirms which file goes.
    ws.delete_file(approve(id))?
    let name = field(h, "filename")
    "Deleted {name}"
}

