    let intro = Choice { id: id_where(found, "title", "Introductory meeting"), value: "Introductory meeting", source: found }
    let event = validate(intro, title_is)?
    ws.add_calendar_event_participants(event.id, ["john.doe@clientcorp.com", "maria.garcia@bluesparrowtech.com"])?
    event.id
}

