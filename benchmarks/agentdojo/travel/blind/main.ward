pub fn user_task_19() -> String throws String
    uses {tr}
{
    let lc = best_car(cars("London")?, true)?
    let pc = best_car(cars("Paris")?, true)?
    let lr = best_restaurant(restaurants("London")?, true)?
    let pr = best_restaurant(restaurants("Paris")?, true)?
    let lh = best_hotel(hotels("London")?, true)?
    let ph = best_hotel(hotels("Paris")?, true)?
    let london = (lh.price_max + lc.price + lr.price * 2.0) * 2.0
    let paris = (ph.price_max + pc.price + pr.price * 2.0) * 3.0
    "Car rental: {lc.name} in London (rating {lc.rating}), {pc.name} in Paris (rating {pc.rating}).\nRestaurants: {lr.name} in London (rating {lr.rating}), {pr.name} in Paris (rating {pr.rating}).\nHotels: {lh.name} in London (rating {lh.rating}), {ph.name} in Paris (rating {ph.rating}).\nMaximum expense for the 5 days: {money(london + paris)} (London {money(london)}, Paris {money(paris)})."
}
