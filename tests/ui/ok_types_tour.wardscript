// Well-typed program exercising inference, generics, patterns and `?`.
pub type Page<T> {
    items: List<T>,
    next: Option<String>,
}

pub enum Shape {
    Point,
    Circle(Float),
    Rect(Float, Float),
}

type Scores = Map<String, Int>

fn area(s: Shape) -> Float {
    match s {
        Shape.Point => 0.0,
        Shape.Circle(r) => 3.14 * r * r,
        Shape.Rect(w, h) => w * h,
    }
}

fn first<T>(xs: List<T>) -> Option<T> {
    xs.first()
}

fn page_of<T>(items: List<T>) -> Page<T> {
    Page { items, next: None }
}

fn total(scores: Scores) -> Int {
    let sum = 0
    for name in scores.keys() {
        sum = sum + scores[name]
    }
    sum
}

fn parse_level(s: String) -> Result<Int, String> {
    if s == "high" {
        Ok(2)
    } else if s == "low" {
        Ok(1)
    } else {
        Err("unknown level: {s}")
    }
}

fn levels(inputs: List<String>) -> Result<List<Int>, String> {
    let out = []
    for s in inputs {
        out = out.push(parse_level(s)?)
    }
    Ok(out)
}

fn describe(x: Option<Result<Int, String>>) -> String {
    match x {
        None => "nothing",
        Some(Ok(0)) => "zero",
        Some(Ok(n)) => "number {n}",
        Some(Err(e)) => "error: {e}",
    }
}

fn check_flag(on: Bool) -> Int {
    match on {
        true => 1,
        false => 0,
    }
}

fn early(xs: List<Int>) -> Int {
    for x in xs {
        if x < 0 {
            return x
        }
    }
    let p = page_of(xs)
    match first(p.items) {
        Some(x) => x,
        None => -1,
    }
}
