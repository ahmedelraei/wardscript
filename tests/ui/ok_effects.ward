// Effects that are all declared: a whole tool covers its functions, an `ai fn` implies
// `llm`, and a `validate` rule's effects count for its caller.
import mcp "gmail" as mail
import mcp "audit" as audit
#[readonly(search)]
#[private(read_contact)]
import mcp "contacts" as contacts

ai fn draft(topic: String) -> String
    budget {tokens: 1000, calls: 2}
{
    "Write about {topic}"
}

fn logged(text: String) -> Bool
    uses {audit.log}
{
    audit.log("validated a draft")
    !text.is_empty()
}

pub fn send(topic: String) -> String throws String
    uses {llm, mail, audit}
    budget {tokens: 2000, calls: 2, cost: 0.05, time: 30}
{
    let text = validate(draft(topic), logged)?
    mail.send("team@example.com", topic, text)
    mail.archive(topic)
    text
}

// Only two of the three: it reads private data and writes, but its input is trusted.
pub fn share(name: String)
    uses {contacts, mail.send}
{
    contacts.search(name)
    let email = contacts.read_contact(name)
    mail.send("team@example.com", "contact", declassify(email, "the team may see contacts"))
}

pub fn pure(x: Int) -> Int {
    x + 1
}
